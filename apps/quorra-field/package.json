{
  "name": "quorra-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:app": "tsc --noEmit && VITE_BASE=./ VITE_HASH_ROUTER=1 vite build --outDir dist-app --emptyOutDir",
    "cap:sync": "npm run build:app && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/stripe-terminal": "^6.5.1",
    "@capacitor/android": "^6.2.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^6.2.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
